# ── Supabase ───────────────────────────────────────────────
# Projeto NOVO, não o do radar-dispensas. Project Settings > API.
# A service_role ignora RLS: só no servidor, nunca com prefixo NEXT_PUBLIC_.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Acesso à mesa de operação ──────────────────────────────
# Senha de quem opera (você). SESSAO_SEGREDO assina o cookie de sessão:
# gere com  openssl rand -hex 32. Trocar qualquer um derruba as sessões.
OPERADOR_SENHA=
SESSAO_SEGREDO=

# Endereço público do app. Vai nos links do portal que o cliente recebe.
APP_URL=http://localhost:3000

# ── Proteção do endpoint de coleta ─────────────────────────
# Gere com: openssl rand -hex 32
CRON_SECRET=

# ── O que coletar ──────────────────────────────────────────
# 6 = Pregão eletrônico, 4 = Concorrência eletrônica, 8 = Dispensa.
# Presenciais (5, 7) ficam fora: exigem alguém na sala do órgão.
MODALIDADES=6,4,8
# Quantos dias à frente considerar (encerramento das propostas)
JANELA_DIAS=45
# Orçamento de tempo de uma execução da coleta. Vercel Hobby = 60s de teto.
SYNC_ORCAMENTO_MS=45000

# ── WhatsApp (Evolution API) ───────────────────────────────
# Sem isso nada é enviado: nem alerta para você, nem convite para o cliente.
EVOLUTION_API_URL=https://sua-evolution.exemplo
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
# O SEU número: recebe alertas de licitação nova, retificação de edital e
# as respostas dos clientes.
ALERTA_WHATSAPP_NUMERO=5527999999999

# ── IA ─────────────────────────────────────────────────────
# Provedor: openai (padrão) ou anthropic
AI_PROVIDER=openai
OPENAI_API_KEY=
# Ajuste para um modelo que a sua conta enxerga
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
